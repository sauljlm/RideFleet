# MongoDB Atlas
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Servidor
PORT=3001
FRONTEND_URL=http://localhost:3000

# Envío de correos (recuperación de contraseña) por SMTP de Gmail.
# GMAIL_USER es la cuenta que envía. GMAIL_APP_PASSWORD NO es la contraseña
# normal de Google: es una "contraseña de aplicación" de 16 caracteres que se
# genera en https://myaccount.google.com/apppasswords y requiere tener activa
# la verificación en 2 pasos. Se pueden pegar los espacios que muestra Google.
# El remitente siempre es GMAIL_USER (Gmail lo reescribe si no coincide);
# EMAIL_FROM_NAME solo cambia el nombre visible.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=RideFleet

# Solo usados por el script de seed (scripts/seed-admin.ts), no se guardan en la app
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Solo usados por el script de migración a multi-usuario
# (scripts/migrate-multi-tenant.ts), una sola vez, no se guardan en la app
ADMIN_EMAIL=
ADMIN_FULLNAME=

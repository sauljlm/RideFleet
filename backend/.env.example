# MongoDB Atlas
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Servidor
PORT=3001
FRONTEND_URL=http://localhost:3000

# Resend (envío de correos, recuperación de contraseña): https://resend.com
# EMAIL_FROM por defecto usa el remitente de pruebas de Resend, que funciona
# sin verificar un dominio propio pero solo sirve para desarrollo.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Solo usados por el script de seed (scripts/seed-admin.ts), no se guardan en la app
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Solo usados por el script de migración a multi-usuario
# (scripts/migrate-multi-tenant.ts), una sola vez, no se guardan en la app
ADMIN_EMAIL=
ADMIN_FULLNAME=

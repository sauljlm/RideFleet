# URL base de la API del backend.
# En local puedes dejarla vacía: el frontend usa un proxy interno que
# detecta automáticamente el puerto del backend corriendo en localhost.
# En producción (u otro host distinto), defínela, ej.:
# NEXT_PUBLIC_API_URL=https://ridefleet-production.up.railway.app/api
NEXT_PUBLIC_API_URL=
